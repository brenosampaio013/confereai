# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# segredos
.env
.env.local
supabase/functions/.env
supabase/.temp

# chave da conta de serviço do Google Play (nunca versionar)
google-play-service-account.json
*.jks
*.keystore
/e2e-output

# Estado local do wrangler (Cloudflare)
.wrangler/

# Arquivos de trabalho das capturas (regerados por scripts/capture-screens.mjs)
site/assets/telas/_*
# Exceção: as conversões em WebP são versionadas de propósito. O contêiner de compilação do
# Cloudflare não tem ffmpeg, e sem elas o build da landing falha e o site nunca é publicado.
!site/assets/telas/_webp/

# Landing page gerada (npm run build:site)
site-dist/

# Filme (motion-pro): fontes versionadas, saídas geradas não
motion-pro/*/.cache/
motion-pro/*/storyboard/
motion-pro/*/render/
motion-pro/*/filme/
motion-pro/*/previa.html

# vídeo publicitário entregue (gerado a partir de motion-pro/meu-carrin)
MEU_CARRIN_VIDEO_PUBLICITARIO_FINAL.mp4
