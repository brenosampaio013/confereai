/**
 * Publicação da landing page do Meu Carrin no Cloudflare (Workers com arquivos estáticos).
 * É um Worker separado do aplicativo: o app continua com o seu próprio wrangler.jsonc.
 *
 * Build:  npm run build:site      Deploy: npx wrangler deploy -c wrangler.site.jsonc
 *
 * - "directory": pasta gerada por `npm run build:site`.
 * - "not_found_handling": endereço inexistente devolve a página 404 do site.
 * - Os cabeçalhos de segurança e de cache vêm de site-dist/_headers, gerado no build.
 */
{
  "name": "meucarrin-site",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./site-dist",
    "not_found_handling": "404-page"
  }
}
