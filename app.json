{
  "expo": {
    "name": "Meu Carrin",
    "slug": "meu-carrin",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "meucarrin",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F3F5F4",
    "ios": {
      "bundleIdentifier": "com.meucarrin.app",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.meucarrin.app",
      "adaptiveIcon": {
        "backgroundColor": "#0E2A47",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E2A47",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "O Meu Carrin usa a câmera para ler códigos de barras, etiquetas de preço e cupons fiscais.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O Meu Carrin acessa suas fotos apenas quando você escolhe uma imagem de cupom ou etiqueta da galeria.",
          "cameraPermission": "O Meu Carrin usa a câmera para fotografar cupons fiscais, etiquetas e embalagens.",
          "microphonePermission": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "O Meu Carrin usa o microfone apenas enquanto você fala com o assistente, para montar o carrinho pelo que você pedir.",
          "recordAudioAndroid": true,
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O Meu Carrin usa sua localização apenas quando você publica ou confirma uma oferta, para conferir se você está perto do supermercado. Suas coordenadas não são armazenadas.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0E2A47"
        }
      ],
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "Archivo",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/Archivo_400Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/Archivo_500Medium.ttf",
                    "weight": 500
                  },
                  {
                    "path": "./assets/fonts/Archivo_600SemiBold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "./assets/fonts/Archivo_700Bold.ttf",
                    "weight": 700
                  },
                  {
                    "path": "./assets/fonts/Archivo_800ExtraBold.ttf",
                    "weight": 800
                  }
                ]
              }
            ]
          },
          "ios": {
            "fonts": [
              "./assets/fonts/Archivo_400Regular.ttf",
              "./assets/fonts/Archivo_500Medium.ttf",
              "./assets/fonts/Archivo_600SemiBold.ttf",
              "./assets/fonts/Archivo_700Bold.ttf",
              "./assets/fonts/Archivo_800ExtraBold.ttf"
            ]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
