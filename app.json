{
  "expo": {
    "name": "Confere Aí",
    "slug": "confere-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "confereai",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F3F5F8",
    "ios": {
      "bundleIdentifier": "br.com.confereai.app",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "br.com.confereai.app",
      "adaptiveIcon": {
        "backgroundColor": "#0E2A47",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E2A47",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "O Confere Aí usa a câmera para ler códigos de barras, etiquetas de preço e cupons fiscais.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O Confere Aí acessa suas fotos apenas quando você escolhe uma imagem de cupom ou etiqueta da galeria.",
          "cameraPermission": "O Confere Aí usa a câmera para fotografar cupons fiscais, etiquetas e embalagens.",
          "microphonePermission": false
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O Confere Aí usa sua localização apenas quando você publica ou confirma uma oferta, para conferir se você está perto do supermercado. Suas coordenadas não são armazenadas.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0E2A47"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
