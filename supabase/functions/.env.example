# Segredos da Edge Function receipt-ocr. NUNCA coloque estes valores no aplicativo.
# Produção:  supabase secrets set --env-file supabase/functions/.env
# Local:     supabase functions serve --env-file supabase/functions/.env

# "anthropic" (padrão) ou "google_vision"
OCR_PROVIDER=anthropic

# Obrigatória se OCR_PROVIDER=anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=
# Opcional. Padrão: claude-opus-5-5
ANTHROPIC_MODEL=

# Obrigatória se OCR_PROVIDER=google_vision (Cloud Vision API habilitada no projeto Google Cloud)
GOOGLE_VISION_API_KEY=

# A cota de leituras não fica aqui: vem da tabela public.plan_limits, pelo plano de cada
# pessoa. Mudar a cota é um update no banco, sem publicar nada.

# --- Assinatura (funções stripe-checkout, stripe-portal e stripe-webhook) ---

# Chave secreta da Stripe. sk_test_... enquanto estiver testando, sk_live_... em produção.
STRIPE_SECRET_KEY=
# Segredo do endpoint de webhook (whsec_...), mostrado pela Stripe ao criar o webhook.
# É o que prova que o aviso veio dela; sem ele a função recusa tudo.
STRIPE_WEBHOOK_SECRET=
# Endereço do aplicativo, para onde a Stripe devolve a pessoa (padrão https://app.meucarrin.com)
APP_URL=
