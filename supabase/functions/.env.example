# Segredos da Edge Function receipt-ocr. NUNCA coloque estes valores no aplicativo.
# Produção:  supabase secrets set --env-file supabase/functions/.env
# Local:     supabase functions serve --env-file supabase/functions/.env

# "anthropic" (padrão) ou "google_vision"
OCR_PROVIDER=anthropic

# Obrigatória se OCR_PROVIDER=anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=
# Opcional. Padrão: claude-opus-5-5
ANTHROPIC_MODEL=

# Obrigatória se OCR_PROVIDER=google_vision (Cloud Vision API habilitada no projeto Google Cloud)
GOOGLE_VISION_API_KEY=

# Limite de leituras por usuário em 24 h (padrão 60)
OCR_DAILY_LIMIT=60
