# Copie para .env e preencha. Variáveis EXPO_PUBLIC_* ficam embutidas no aplicativo:
# use somente valores públicos (a chave "anon" do Supabase é pública e protegida por RLS).
# Sem estas variáveis o app funciona 100% local (sem conta, sincronização ou OCR).

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Consulta opcional à base pública Open Food Facts para sugerir nome/marca (true/false)
EXPO_PUBLIC_OPEN_FOOD_FACTS=true

# E-mail de contato sobre privacidade exibido na política (preencha antes de publicar)
EXPO_PUBLIC_PRIVACY_CONTACT=
